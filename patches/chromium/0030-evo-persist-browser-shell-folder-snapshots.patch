+IN_PROC_BROWSER_TEST_F(EvoShellUIBrowserTest,
+                       PersistedFoldersIgnoreMalformedEntries) {
+  base::ListValue children;
+  base::DictValue valid_child;
+  valid_child.Set("id", "local");
+  valid_child.Set("title", "[LOCAL] TanStack");
+  valid_child.Set("url", "http://localhost:3005/");
+  children.Append(std::move(valid_child));
+  base::DictValue child_without_url;
+  child_without_url.Set("id", "missing-url");
+  child_without_url.Set("title", "Missing URL");
+  children.Append(std::move(child_without_url));
+  base::DictValue child_with_invalid_url;
+  child_with_invalid_url.Set("id", "invalid-url");
+  child_with_invalid_url.Set("title", "Invalid URL");
+  child_with_invalid_url.Set("url", "not a URL");
+  children.Append(std::move(child_with_invalid_url));
+
+  base::ListValue folders;
+  base::DictValue valid_folder;
+  valid_folder.Set("id", "ai-tools");
+  valid_folder.Set("title", "AI IMAGE TOOLS");
+  valid_folder.Set("children", std::move(children));
+  folders.Append(std::move(valid_folder));
+  base::DictValue folder_without_title;
+  folder_without_title.Set("id", "missing-title");
+  folder_without_title.Set("children", base::ListValue());
+  folders.Append(std::move(folder_without_title));
+
+  browser()->profile()->GetPrefs()->SetList(evo::shell::prefs::kFolders,
+                                            std::move(folders));
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser());
+  ASSERT_TRUE(browser_view);
+  auto* coordinator = browser_view->evo_shell_coordinator();
+  ASSERT_TRUE(coordinator);
+  base::DictValue snapshot = coordinator->BuildSnapshot();
+  const base::ListValue* snapshot_folders = snapshot.FindList("folders");
+  ASSERT_TRUE(snapshot_folders);
+  ASSERT_EQ(1u, snapshot_folders->size());
+  const base::DictValue& folder = (*snapshot_folders)[0].GetDict();
+  EXPECT_EQ("ai-tools", *folder.FindString("id"));
+  const base::ListValue* snapshot_children = folder.FindList("children");
+  ASSERT_TRUE(snapshot_children);
+  ASSERT_EQ(1u, snapshot_children->size());
+  const base::DictValue& child = (*snapshot_children)[0].GetDict();
+  EXPECT_EQ("localhost:3005", *child.FindString("url"));
+  EXPECT_TRUE(child.FindBool("pinned").value_or(false));
+}
