@@ -2,8 +2,68 @@
 
 #include "chrome/browser/ui/evo_shell/evo_shell_types.h"
 
+#include "base/strings/escape.h"
+#include "url/gurl.h"
+
 namespace evo::shell {
 
+std::string FaviconUrl(const GURL& page_url) {
+  if (!page_url.is_valid()) {
+    return "chrome://resources/images/icon_globe.svg";
+  }
+  return "chrome://favicon2/?size=32&scale_factor=2x&page_url=" +
+         base::EscapeQueryParamValue(page_url.spec(), true);
+}
+
+std::vector<FolderSnapshot> ParseFolderSnapshots(
+    const base::ListValue& folder_values) {
+  std::vector<FolderSnapshot> folders;
+  for (const auto& folder_value : folder_values) {
+    const base::DictValue* folder = folder_value.GetIfDict();
+    if (!folder) {
+      continue;
+    }
+    const std::string* id = folder->FindString("id");
+    const std::string* title = folder->FindString("title");
+    const base::ListValue* children = folder->FindList("children");
+    if (!id || id->empty() || !title || title->empty() || !children) {
+      continue;
+    }
+
+    FolderSnapshot snapshot{.id = *id, .title = *title};
+    for (const auto& child_value : *children) {
+      const base::DictValue* child = child_value.GetIfDict();
+      if (!child) {
+        continue;
+      }
+      const std::string* child_id = child->FindString("id");
+      const std::string* child_title = child->FindString("title");
+      const std::string* child_url = child->FindString("url");
+      if (!child_id || child_id->empty() || !child_title ||
+          child_title->empty() || !child_url || child_url->empty()) {
+        continue;
+      }
+      const GURL url(*child_url);
+      if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+        continue;
+      }
+      std::string display_url(url.host());
+      if (url.has_port()) {
+        display_url += ":";
+        display_url += url.port();
+      }
+      snapshot.children.push_back(
+          {.id = *child_id,
+           .title = *child_title,
+           .url = std::move(display_url),
+           .favicon_url = FaviconUrl(url),
+           .pinned = true});
+    }
+    folders.push_back(std::move(snapshot));
+  }
+  return folders;
+}
+
 base::DictValue TabSnapshot::ToValue() const {
   base::DictValue value;
   value.Set("id", id);
