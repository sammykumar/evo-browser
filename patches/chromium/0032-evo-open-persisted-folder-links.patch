+IN_PROC_BROWSER_TEST_F(EvoShellUIBrowserTest, PersistedFolderChildOpensUrl) {
+  const GURL expected("https://example.test/folder-child");
+  base::ListValue children;
+  base::DictValue child;
+  child.Set("id", "reference");
+  child.Set("title", "Reference");
+  child.Set("url", expected.spec());
+  children.Append(std::move(child));
+  base::ListValue folders;
+  base::DictValue folder;
+  folder.Set("id", "resources");
+  folder.Set("title", "Resources");
+  folder.Set("children", std::move(children));
+  folders.Append(std::move(folder));
+  browser()->profile()->GetPrefs()->SetList(evo::shell::prefs::kFolders,
+                                            std::move(folders));
+
+  auto* coordinator =
+      BrowserView::GetBrowserViewForBrowser(browser())->evo_shell_coordinator();
+  ASSERT_TRUE(coordinator);
+  const int original_tab_count = browser()->tab_strip_model()->count();
+  base::DictValue action;
+  action.Set("type", "openFolderChild");
+  action.Set("folderId", "resources");
+  action.Set("childId", "reference");
+  coordinator->DispatchAction(action);
+
+  EXPECT_EQ(original_tab_count + 1, browser()->tab_strip_model()->count());
+  EXPECT_EQ(expected,
+            browser()->tab_strip_model()->GetActiveWebContents()->GetVisibleURL());
+}
