+};
+
+// Hosts Evo's trusted sidebar and right-rail WebUIs below Chromium's native
+// content. BrowserView uses the same deterministic layout result to position
+// native toolbar/content, preventing independent offsets from accumulating.
+class EvoShellHostView : public views::View {
+  METADATA_HEADER(EvoShellHostView, views::View)
+
+ public:
+  using FallbackCallback =
+      base::RepeatingCallback<void(EvoShellFallbackReason)>;
+
+  static constexpr int kWindowInset = shell::tokens::kOuterInset;
+  static constexpr int kColumnGap = shell::tokens::kRegionGap;
+  static constexpr int kSidebarWidth = shell::tokens::kSidebarWidth;
+  static constexpr int kRightRailWidth = shell::tokens::kRightRailWidth;
+
+  EvoShellHostView(Profile* profile,
+                   FallbackCallback fallback_callback,
+                   base::RepeatingClosure ready_callback,
+                   base::TimeDelta readiness_timeout = base::Seconds(8));
+  EvoShellHostView(const EvoShellHostView&) = delete;
+  EvoShellHostView& operator=(const EvoShellHostView&) = delete;
+  ~EvoShellHostView() override;
+
+  static EvoShellLayout CalculateLayout(const gfx::Rect& available_bounds,
+                                        bool sidebar_collapsed,
+                                        bool right_rail_visible);
+
+  void SetSidebarCollapsed(bool collapsed);
+  void SetRightRailVisible(bool visible);
+  void SetTheme(EvoNativeTheme theme);
+  void MarkSurfaceReady(EvoShellSurface surface);
+  void ActivateFallback(EvoShellFallbackReason reason);
+
+  bool surfaces_ready() const { return surfaces_ready_; }
+  bool fallback_active() const { return fallback_active_; }
+  bool sidebar_collapsed() const { return sidebar_collapsed_; }
+  bool right_rail_visible() const { return right_rail_visible_; }
+  const EvoShellLayout& shell_layout() const { return shell_layout_; }
+  gfx::Rect content_bounds() const { return shell_layout_.content_bounds; }
+  gfx::Rect traffic_light_reserved_bounds() const {
+    return shell_layout_.traffic_light_reserved_bounds;
+  }
+
+ protected:
+  void Layout(PassKey) override;
+  void OnPaintBackground(gfx::Canvas* canvas) override;
+
+ private:
+  class SurfaceObserver;
+
+  void OnReadinessTimeout();
+  void RecalculateLayout();
+
+  raw_ptr<views::WebView> sidebar_web_view_ = nullptr;
+  raw_ptr<views::WebView> right_rail_web_view_ = nullptr;
+  std::unique_ptr<SurfaceObserver> sidebar_observer_;
+  std::unique_ptr<SurfaceObserver> right_rail_observer_;
+  FallbackCallback fallback_callback_;
+  base::RepeatingClosure ready_callback_;
+  base::OneShotTimer readiness_timer_;
+  EvoShellLayout shell_layout_;
+  EvoNativeTheme theme_ = EvoNativeTheme::kAgent;
+  bool sidebar_ready_ = false;
+  bool right_rail_ready_ = false;
+  bool surfaces_ready_ = false;
+  bool fallback_active_ = false;
+  bool sidebar_collapsed_ = false;
+  bool right_rail_visible_ = true;
+};
