+constexpr int kTrafficLightInset = 18;
+constexpr int kTrafficLightWidth = 60;
+constexpr int kTrafficLightHeight = 14;
+
+std::array<SkColor4f, 3> ThemeColors(EvoNativeTheme theme) {
+  switch (theme) {
+    case EvoNativeTheme::kPersonal:
+      return {SkColor4f::FromColor(SkColorSetRGB(0x7c, 0x8c, 0xff)),
+              SkColor4f::FromColor(SkColorSetRGB(0x9b, 0x7b, 0xf3)),
+              SkColor4f::FromColor(SkColorSetRGB(0x0d, 0x0f, 0x13))};
+    case EvoNativeTheme::kWork:
+      return {SkColor4f::FromColor(SkColorSetRGB(0x5f, 0xd3, 0xa3)),
+              SkColor4f::FromColor(SkColorSetRGB(0x4f, 0xb8, 0xd8)),
+              SkColor4f::FromColor(SkColorSetRGB(0x0d, 0x0f, 0x13))};
+    case EvoNativeTheme::kMedia:
+      return {SkColor4f::FromColor(SkColorSetRGB(0xf2, 0x86, 0xa6)),
+              SkColor4f::FromColor(SkColorSetRGB(0xb0, 0x6f, 0xf0)),
+              SkColor4f::FromColor(SkColorSetRGB(0x0d, 0x0f, 0x13))};
+    case EvoNativeTheme::kFocus:
+      return {SkColor4f::FromColor(SkColorSetRGB(0x6e, 0xa8, 0xf5)),
+              SkColor4f::FromColor(SkColorSetRGB(0x57, 0xdc, 0xd6)),
+              SkColor4f::FromColor(SkColorSetRGB(0x0d, 0x0f, 0x13))};
+    case EvoNativeTheme::kAgent:
+      return {SkColor4f::FromColor(SkColorSetRGB(0x57, 0xdc, 0xd6)),
+              SkColor4f::FromColor(SkColorSetRGB(0x8f, 0x7b, 0xf3)),
+              SkColor4f::FromColor(SkColorSetRGB(0x0d, 0x0f, 0x13))};
+  }
+}
+
+}  // namespace
+
+class EvoShellHostView::SurfaceObserver : public content::WebContentsObserver {
+ public:
+  SurfaceObserver(EvoShellHostView* host,
+                  EvoShellSurface surface,
+                  content::WebContents* web_contents)
+      : content::WebContentsObserver(web_contents),
+        host_(host),
+        surface_(surface) {}
+
+  void DidFinishNavigation(
+      content::NavigationHandle* navigation_handle) override {
+    if (navigation_handle->IsInPrimaryMainFrame() &&
+        navigation_handle->HasCommitted() &&
+        !navigation_handle->IsErrorPage()) {
+      host_->MarkSurfaceReady(surface_);
+    }
+  }
+
+  void WebContentsDestroyed() override {
+    host_->ActivateFallback(surface_ == EvoShellSurface::kSidebar
+                                ? EvoShellFallbackReason::kSidebarDestroyed
+                                : EvoShellFallbackReason::kRailDestroyed);
+  }
+
+ private:
+  const raw_ptr<EvoShellHostView> host_;
+  const EvoShellSurface surface_;
+};
+
+EvoShellHostView::EvoShellHostView(Profile* profile,
+                                   FallbackCallback fallback_callback,
+                                   base::RepeatingClosure ready_callback,
+                                   base::TimeDelta readiness_timeout)
+    : fallback_callback_(std::move(fallback_callback)),
+      ready_callback_(std::move(ready_callback)) {
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(true);
+
+  if (!profile) {
+    return;
+  }
+
+  sidebar_web_view_ = AddChildView(std::make_unique<views::WebView>(profile));
+  right_rail_web_view_ =
+      AddChildView(std::make_unique<views::WebView>(profile));
+  sidebar_web_view_->SetVisible(false);
+  right_rail_web_view_->SetVisible(false);
+
+  sidebar_web_view_->LoadInitialURL(
+      GURL(base::StrCat({chrome::kChromeUIEvoShellURL, "?surface=sidebar"})));
+  right_rail_web_view_->LoadInitialURL(
+      GURL(base::StrCat({chrome::kChromeUIEvoShellURL, "?surface=rail"})));
+
+  sidebar_observer_ = std::make_unique<SurfaceObserver>(
+      this, EvoShellSurface::kSidebar, sidebar_web_view_->GetWebContents());
+  right_rail_observer_ =
+      std::make_unique<SurfaceObserver>(this, EvoShellSurface::kRightRail,
+                                        right_rail_web_view_->GetWebContents());
+
+  readiness_timer_.Start(FROM_HERE, readiness_timeout,
+                         base::BindOnce(&EvoShellHostView::OnReadinessTimeout,
+                                        base::Unretained(this)));
+}
+
+EvoShellHostView::~EvoShellHostView() = default;
+
+// static
+EvoShellLayout EvoShellHostView::CalculateLayout(
+    const gfx::Rect& available_bounds,
+    bool sidebar_collapsed,
+    bool right_rail_visible) {
+  gfx::Rect inner = available_bounds;
+  inner.Inset(kWindowInset);
+
+  EvoShellLayout layout;
+  int content_left = inner.x();
+  if (!sidebar_collapsed) {
+    const int sidebar_width = std::min(kSidebarWidth, inner.width());
+    layout.sidebar_bounds =
+        gfx::Rect(inner.x(), inner.y(), sidebar_width, inner.height());
+    content_left = layout.sidebar_bounds.right() + kColumnGap;
+  }
+
+  int content_right = inner.right();
+  if (right_rail_visible) {
+    const int rail_width = std::min(kRightRailWidth, inner.width());
+    layout.right_rail_bounds = gfx::Rect(inner.right() - rail_width, inner.y(),
+                                         rail_width, inner.height());
+    content_right = layout.right_rail_bounds.x() - kColumnGap;
+  }
+
+  layout.content_bounds =
+      gfx::Rect(content_left, inner.y(),
+                std::max(0, content_right - content_left), inner.height());
+
+  const gfx::Rect& traffic_region =
+      sidebar_collapsed ? layout.content_bounds : layout.sidebar_bounds;
+  layout.traffic_light_reserved_bounds =
+      gfx::Rect(traffic_region.x() + kTrafficLightInset,
+                traffic_region.y() + kTrafficLightInset, kTrafficLightWidth,
+                kTrafficLightHeight);
+  return layout;
+}
+
+void EvoShellHostView::SetSidebarCollapsed(bool collapsed) {
+  if (sidebar_collapsed_ == collapsed) {
+    return;
+  }
+  sidebar_collapsed_ = collapsed;
+  InvalidateLayout();
+}
+
+void EvoShellHostView::SetRightRailVisible(bool visible) {
+  if (right_rail_visible_ == visible) {
+    return;
+  }
+  right_rail_visible_ = visible;
+  InvalidateLayout();
+}
+
+void EvoShellHostView::SetTheme(EvoNativeTheme theme) {
+  if (theme_ == theme) {
+    return;
+  }
+  theme_ = theme;
+  SchedulePaint();
+}
+
+void EvoShellHostView::MarkSurfaceReady(EvoShellSurface surface) {
+  if (fallback_active_ || surfaces_ready_) {
+    return;
+  }
+  if (surface == EvoShellSurface::kSidebar) {
+    sidebar_ready_ = true;
+  } else {
+    right_rail_ready_ = true;
+  }
+  if (!sidebar_ready_ || !right_rail_ready_) {
+    return;
+  }
+
+  readiness_timer_.Stop();
+  surfaces_ready_ = true;
+  sidebar_web_view_->SetVisible(!sidebar_collapsed_);
+  right_rail_web_view_->SetVisible(right_rail_visible_);
+  ready_callback_.Run();
+}
+
+void EvoShellHostView::ActivateFallback(EvoShellFallbackReason reason) {
+  if (fallback_active_) {
+    return;
+  }
+  fallback_active_ = true;
+  surfaces_ready_ = false;
+  readiness_timer_.Stop();
+  if (sidebar_web_view_) {
+    sidebar_web_view_->SetVisible(false);
+  }
+  if (right_rail_web_view_) {
+    right_rail_web_view_->SetVisible(false);
+  }
+  fallback_callback_.Run(reason);
+}
+
+void EvoShellHostView::Layout(PassKey) {
+  RecalculateLayout();
+  if (sidebar_web_view_) {
+    sidebar_web_view_->SetBoundsRect(shell_layout_.sidebar_bounds);
+    sidebar_web_view_->SetVisible(surfaces_ready_ && !sidebar_collapsed_);
+  }
+  if (right_rail_web_view_) {
+    right_rail_web_view_->SetBoundsRect(shell_layout_.right_rail_bounds);
+    right_rail_web_view_->SetVisible(surfaces_ready_ && right_rail_visible_);
+  }
+}
+
+void EvoShellHostView::OnPaintBackground(gfx::Canvas* canvas) {
+  const auto colors = ThemeColors(theme_);
+  const SkPoint points[] = {
+      gfx::PointToSkPoint(GetLocalBounds().origin()),
+      gfx::PointToSkPoint(GetLocalBounds().bottom_right())};
+  cc::PaintFlags wallpaper_flags;
+  wallpaper_flags.setAntiAlias(true);
+  wallpaper_flags.setShader(cc::PaintShader::MakeLinearGradient(
+      points, colors.data(), nullptr, colors.size(), SkTileMode::kClamp));
+  canvas->DrawRect(GetLocalBounds(), wallpaper_flags);
+
+  cc::PaintFlags content_flags;
+  content_flags.setAntiAlias(true);
+  content_flags.setColor(SkColorSetRGB(0x0d, 0x0f, 0x13));
+  canvas->DrawRoundRect(gfx::RectF(shell_layout_.content_bounds),
+                        shell::tokens::kSurfaceRadius, content_flags);
+}
+
+void EvoShellHostView::OnReadinessTimeout() {
+  ActivateFallback(EvoShellFallbackReason::kReadinessTimeout);
+}
+
+void EvoShellHostView::RecalculateLayout() {
+  shell_layout_ = CalculateLayout(GetLocalBounds(), sidebar_collapsed_,
+                                  right_rail_visible_);
+}
