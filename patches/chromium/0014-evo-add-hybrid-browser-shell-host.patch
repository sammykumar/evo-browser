+namespace evo {
+namespace {
+
+TEST(EvoShellHostViewTest, CalculatesStableThreeColumnLayouts) {
+  struct TestCase {
+    bool sidebar_collapsed;
+    bool right_rail_visible;
+    int expected_content_x;
+    int expected_content_width;
+  };
+
+  constexpr std::array<TestCase, 4> kTestCases = {{
+      {false, true, 312, 780},
+      {false, false, 312, 870},
+      {true, true, 18, 1074},
+      {true, false, 18, 1164},
+  }};
+
+  for (const auto& test_case : kTestCases) {
+    SCOPED_TRACE(testing::Message()
+                 << "sidebar_collapsed=" << test_case.sidebar_collapsed
+                 << " right_rail_visible=" << test_case.right_rail_visible);
+    const gfx::Rect available_bounds(0, 0, 1200, 800);
+    const EvoShellLayout expected = EvoShellHostView::CalculateLayout(
+        available_bounds, test_case.sidebar_collapsed,
+        test_case.right_rail_visible);
+
+    EXPECT_EQ(expected.content_bounds.x(), test_case.expected_content_x);
+    EXPECT_EQ(expected.content_bounds.width(),
+              test_case.expected_content_width);
+    EXPECT_EQ(expected.content_bounds.y(), EvoShellHostView::kWindowInset);
+    EXPECT_EQ(expected.content_bounds.bottom(),
+              available_bounds.bottom() - EvoShellHostView::kWindowInset);
+
+    if (test_case.sidebar_collapsed) {
+      EXPECT_TRUE(expected.sidebar_bounds.IsEmpty());
+      EXPECT_TRUE(expected.content_bounds.Contains(
+          expected.traffic_light_reserved_bounds));
+    } else {
+      EXPECT_EQ(expected.sidebar_bounds.width(),
+                EvoShellHostView::kSidebarWidth);
+      EXPECT_TRUE(expected.sidebar_bounds.Contains(
+          expected.traffic_light_reserved_bounds));
+    }
+
+    if (test_case.right_rail_visible) {
+      EXPECT_EQ(expected.right_rail_bounds.width(),
+                EvoShellHostView::kRightRailWidth);
+      EXPECT_EQ(expected.content_bounds.right() + EvoShellHostView::kColumnGap,
+                expected.right_rail_bounds.x());
+    } else {
+      EXPECT_TRUE(expected.right_rail_bounds.IsEmpty());
+    }
+
+    for (int i = 0; i < 10; ++i) {
+      EXPECT_EQ(EvoShellHostView::CalculateLayout(available_bounds,
+                                                  test_case.sidebar_collapsed,
+                                                  test_case.right_rail_visible),
+                expected);
+    }
+  }
+}
+
+TEST(EvoShellHostViewTest, CollapsingRegionsReturnsTheirWidthAndGap) {
+  const gfx::Rect available_bounds(0, 0, 1200, 800);
+  const EvoShellLayout all_regions =
+      EvoShellHostView::CalculateLayout(available_bounds, false, true);
+  const EvoShellLayout sidebar_collapsed =
+      EvoShellHostView::CalculateLayout(available_bounds, true, true);
+  const EvoShellLayout rail_hidden =
+      EvoShellHostView::CalculateLayout(available_bounds, false, false);
+
+  EXPECT_EQ(sidebar_collapsed.content_bounds.width() -
+                all_regions.content_bounds.width(),
+            EvoShellHostView::kSidebarWidth + EvoShellHostView::kColumnGap);
+  EXPECT_EQ(
+      rail_hidden.content_bounds.width() - all_regions.content_bounds.width(),
+      EvoShellHostView::kRightRailWidth + EvoShellHostView::kColumnGap);
+}
+
+TEST(EvoShellHostViewTest, ContentWidthNeverBecomesNegative) {
+  const EvoShellLayout layout =
+      EvoShellHostView::CalculateLayout(gfx::Rect(0, 0, 100, 80), false, true);
+  EXPECT_GE(layout.content_bounds.width(), 0);
+  EXPECT_GE(layout.content_bounds.height(), 0);
+}
+
+TEST(EvoShellHostViewTest, FallbackCallbackRunsExactlyOnce) {
+  int fallback_count = 0;
+  EvoShellHostView host(
+      /*profile=*/nullptr,
+      base::BindRepeating([](int* count, EvoShellFallbackReason) { ++*count; },
+                          &fallback_count),
+      base::DoNothing(), base::TimeDelta());
+
+  host.ActivateFallback(EvoShellFallbackReason::kReadinessTimeout);
+  host.ActivateFallback(EvoShellFallbackReason::kSidebarDestroyed);
+  host.ActivateFallback(EvoShellFallbackReason::kRailDestroyed);
+
+  EXPECT_EQ(fallback_count, 1);
+}
+
+}  // namespace
+}  // namespace evo
