+
+enum class EvoNativeTheme { kAgent, kPersonal, kWork, kMedia, kFocus };
+
+struct EvoShellLayout {
+  bool operator==(const EvoShellLayout&) const = default;
+
+  gfx::Rect sidebar_bounds;
