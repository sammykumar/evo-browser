+void BrowserView::OnEvoShellReady() {
+  if (!evo_shell_host_ || evo_shell_host_->fallback_active()) {
+    return;
+  }
+  evo_shell_active_ = true;
+  if (vertical_tab_strip_region_view_) {
+    vertical_tab_strip_region_view_->SetVisible(false);
+  }
+  if (vertical_tab_strip_top_corner_) {
+    vertical_tab_strip_top_corner_->SetVisible(false);
+  }
+  if (vertical_tab_strip_bottom_corner_) {
+    vertical_tab_strip_bottom_corner_->SetVisible(false);
+  }
+  if (evo_right_rail_) {
+    evo_right_rail_->SetVisible(false);
+  }
+  InvalidateLayout();
+}
+
+void BrowserView::OnEvoShellFallback(evo::EvoShellFallbackReason reason) {
+  evo_shell_active_ = false;
+  if (evo_shell_host_) {
+    evo_shell_host_->SetVisible(false);
+  }
+  if (auto* controller =
+          tabs::VerticalTabStripStateController::From(browser_.get())) {
+    const bool show_vertical_tabs = controller->ShouldDisplayVerticalTabs();
+    if (vertical_tab_strip_region_view_) {
+      vertical_tab_strip_region_view_->SetVisible(show_vertical_tabs);
+    }
+  }
+  if (evo_right_rail_) {
+    evo_right_rail_->SetVisible(true);
+  }
+  InvalidateLayout();
+}
