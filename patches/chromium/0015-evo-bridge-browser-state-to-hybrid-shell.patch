+#ifndef CHROME_BROWSER_UI_EVO_SHELL_EVO_SHELL_COORDINATOR_H_
+#define CHROME_BROWSER_UI_EVO_SHELL_EVO_SHELL_COORDINATOR_H_
+
+#include <string>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+
+class Browser;
+class Profile;
+class TabStripModel;
+
+namespace evo {
+class EvoShellHostView;
+
+namespace shell {
+
+class EvoShellCoordinator : public TabStripModelObserver {
+ public:
+  EvoShellCoordinator(Browser* browser,
+                      Profile* profile,
+                      EvoShellHostView* host);
+  EvoShellCoordinator(const EvoShellCoordinator&) = delete;
+  EvoShellCoordinator& operator=(const EvoShellCoordinator&) = delete;
+  ~EvoShellCoordinator() override;
+
+  base::DictValue BuildSnapshot() const;
+  base::DictValue DispatchAction(const base::DictValue& action);
+  base::CallbackListSubscription AddSnapshotChangedCallback(
+      base::RepeatingCallback<void(const base::DictValue&)> callback);
+
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      int index,
+                      TabChangeType change_type) override;
+  void OnTabGroupFocusChanged(
+      std::optional<tab_groups::TabGroupId> new_focused_group_id,
+      std::optional<tab_groups::TabGroupId> old_focused_group_id) override;
+
+ private:
+  int FindTabIndex(const std::string& id) const;
+  void ScheduleSnapshotChanged();
+  void NotifySnapshotChanged();
+
+  const raw_ptr<Browser> browser_;
+  const raw_ptr<Profile> profile_;
+  const raw_ptr<EvoShellHostView> host_;
+  base::RepeatingCallbackList<void(const base::DictValue&)>
+      snapshot_callbacks_;
+  std::string active_rail_target_ = "ask-evo";
+  bool notification_scheduled_ = false;
+  base::WeakPtrFactory<EvoShellCoordinator> weak_ptr_factory_{this};
+};
+
+}  // namespace shell
+}  // namespace evo
+
+#endif  // CHROME_BROWSER_UI_EVO_SHELL_EVO_SHELL_COORDINATOR_H_
