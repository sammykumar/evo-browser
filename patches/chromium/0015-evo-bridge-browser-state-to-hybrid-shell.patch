+namespace {
+
+class EvoShellMessageHandler : public content::WebUIMessageHandler {
+ public:
+  EvoShellMessageHandler() = default;
+  EvoShellMessageHandler(const EvoShellMessageHandler&) = delete;
+  EvoShellMessageHandler& operator=(const EvoShellMessageHandler&) = delete;
+  ~EvoShellMessageHandler() override = default;
+
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "getEvoShellSnapshot",
+        base::BindRepeating(&EvoShellMessageHandler::HandleGetSnapshot,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "dispatchEvoShellAction",
+        base::BindRepeating(&EvoShellMessageHandler::HandleDispatchAction,
+                            base::Unretained(this)));
+    web_ui()->RegisterMessageCallback(
+        "evoShellReady",
+        base::BindRepeating(&EvoShellMessageHandler::HandleReady,
+                            base::Unretained(this)));
+  }
+
+  void OnJavascriptDisallowed() override { snapshot_subscription_ = {}; }
+
+ private:
+  BrowserView* GetOwner() {
+    return evo::EvoShellHostView::GetOwnerForWebContents(
+        web_ui()->GetWebContents());
+  }
+
+  evo::shell::EvoShellCoordinator* GetCoordinator() {
+    BrowserView* owner = GetOwner();
+    return owner ? owner->evo_shell_coordinator() : nullptr;
+  }
+
+  std::string Surface() {
+    const std::string query(
+        web_ui()->GetWebContents()->GetLastCommittedURL().query());
+    if (query.find("surface=sidebar") != std::string::npos) {
+      return "sidebar";
+    }
+    if (query.find("surface=rail") != std::string::npos) {
+      return "rail";
+    }
+    return std::string();
+  }
+
+  void EnsureSubscribed() {
+    if (snapshot_subscription_) {
+      return;
+    }
+    if (auto* coordinator = GetCoordinator()) {
+      snapshot_subscription_ = coordinator->AddSnapshotChangedCallback(
+          base::BindRepeating(&EvoShellMessageHandler::OnSnapshotChanged,
+                              base::Unretained(this)));
+    }
+  }
+
+  void HandleGetSnapshot(const base::ListValue& args) {
+    AllowJavascript();
+    EnsureSubscribed();
+    auto* coordinator = GetCoordinator();
+    ResolveJavascriptCallback(
+        args[0].Clone(), coordinator ? base::Value(coordinator->BuildSnapshot())
+                                     : base::Value(base::DictValue()));
+  }
+
+  void HandleDispatchAction(const base::ListValue& args) {
+    AllowJavascript();
+    auto* coordinator = GetCoordinator();
+    const base::DictValue* action =
+        args.size() > 1 ? args[1].GetIfDict() : nullptr;
+    bool allowed = false;
+    if (coordinator && action) {
+      const std::string* type = action->FindString("type");
+      allowed =
+          type && ((Surface() == "sidebar" && *type != "selectRailTarget") ||
+                   (Surface() == "rail" && *type == "selectRailTarget"));
+    }
+    ResolveJavascriptCallback(
+        args[0].Clone(),
+        base::Value(allowed       ? coordinator->DispatchAction(*action)
+                    : coordinator ? coordinator->BuildSnapshot()
+                                  : base::DictValue()));
+  }
+
+  void HandleReady(const base::ListValue& args) {
+    AllowJavascript();
+    const std::string* requested_surface =
+        args.size() > 1 ? args[1].GetIfString() : nullptr;
+    BrowserView* owner = GetOwner();
+    if (owner && requested_surface && *requested_surface == Surface()) {
+      owner->evo_shell_host_for_testing()->MarkSurfaceReady(
+          *requested_surface == "sidebar" ? evo::EvoShellSurface::kSidebar
+                                          : evo::EvoShellSurface::kRightRail);
+    }
+    ResolveJavascriptCallback(args[0].Clone(), base::Value(true));
+  }
+
+  void OnSnapshotChanged(const base::DictValue& snapshot) {
+    if (IsJavascriptAllowed()) {
+      FireWebUIListener("evo-shell-snapshot-changed",
+                        base::Value(snapshot.Clone()));
+    }
+  }
+
+  base::CallbackListSubscription snapshot_subscription_;
+};
+
