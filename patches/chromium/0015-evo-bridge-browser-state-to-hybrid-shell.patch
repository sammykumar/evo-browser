@@ -0,0 +1,60 @@
+// Copyright 2026 SK Productions LLC
+
+#ifndef CHROME_BROWSER_UI_EVO_SHELL_EVO_SHELL_TYPES_H_
+#define CHROME_BROWSER_UI_EVO_SHELL_EVO_SHELL_TYPES_H_
+
+#include <string>
+#include <vector>
+
+#include "base/values.h"
+
+namespace evo::shell {
+
+struct TabSnapshot {
+  base::DictValue ToValue() const;
+  std::string id;
+  std::string title;
+  std::string url;
+  std::string favicon_url;
+  bool active = false;
+  bool loading = false;
+  bool pinned = false;
+};
+
+struct FavoriteSnapshot {
+  base::DictValue ToValue() const;
+  std::string id;
+  std::string title;
+  std::string favicon_url;
+};
+
+struct SpaceSnapshot {
+  base::DictValue ToValue() const;
+  std::string id;
+  std::string name;
+  std::string mode;
+  int badge = 0;
+};
+
+struct FolderSnapshot {
+  base::DictValue ToValue() const;
+  std::string id;
+  std::string title;
+  std::vector<TabSnapshot> children;
+};
+
+struct ShellSnapshot {
+  base::DictValue ToValue() const;
+  std::string active_space_id;
+  std::vector<SpaceSnapshot> spaces;
+  std::vector<FavoriteSnapshot> favorites;
+  std::vector<TabSnapshot> pinned_tabs;
+  std::vector<FolderSnapshot> folders;
+  std::vector<TabSnapshot> open_tabs;
+  bool sidebar_collapsed = false;
+  std::string active_rail_target = "ask-evo";
+};
+
+}  // namespace evo::shell
+
+#endif  // CHROME_BROWSER_UI_EVO_SHELL_EVO_SHELL_TYPES_H_
