+// Copyright 2026 SK Productions LLC
+
+#include "chrome/browser/ui/evo_shell/evo_shell_types.h"
+
+namespace evo::shell {
+
+base::DictValue TabSnapshot::ToValue() const {
+  base::DictValue value;
+  value.Set("id", id);
+  value.Set("title", title);
+  if (!url.empty()) {
+    value.Set("url", url);
+  }
+  value.Set("faviconUrl", favicon_url);
+  value.Set("active", active);
+  value.Set("loading", loading);
+  value.Set("pinned", pinned);
+  return value;
+}
+
+base::DictValue FavoriteSnapshot::ToValue() const {
+  base::DictValue value;
+  value.Set("id", id);
+  value.Set("title", title);
+  value.Set("faviconUrl", favicon_url);
+  return value;
+}
+
+base::DictValue SpaceSnapshot::ToValue() const {
+  base::DictValue value;
+  value.Set("id", id);
+  value.Set("name", name);
+  value.Set("mode", mode);
+  if (badge > 0) {
+    value.Set("badge", badge);
+  }
+  return value;
+}
+
+base::DictValue FolderSnapshot::ToValue() const {
+  base::ListValue child_values;
+  for (const auto& child : children) {
+    child_values.Append(child.ToValue());
+  }
+  base::DictValue value;
+  value.Set("id", id);
+  value.Set("title", title);
+  value.Set("children", std::move(child_values));
+  return value;
+}
+
+base::DictValue ShellSnapshot::ToValue() const {
+  auto serialize = [](const auto& values) {
+    base::ListValue result;
+    for (const auto& value : values) {
+      result.Append(value.ToValue());
+    }
+    return result;
+  };
+
+  base::DictValue value;
+  value.Set("activeSpaceId", active_space_id);
+  value.Set("spaces", serialize(spaces));
+  value.Set("favorites", serialize(favorites));
+  value.Set("pinnedTabs", serialize(pinned_tabs));
+  value.Set("folders", serialize(folders));
+  value.Set("openTabs", serialize(open_tabs));
+  value.Set("sidebarCollapsed", sidebar_collapsed);
+  value.Set("activeRailTarget", active_rail_target);
+  return value;
+}
+
+}  // namespace evo::shell
diff --git a/chrome/browser/ui/evo_shell/evo_shell_types.h b/chrome/browser/ui/evo_shell/evo_shell_types.h
new file mode 100644
index 0000000000000000000000000000000000000000..ebadb05fda1651215215fb4bc5d859eb2c837c6c
--- /dev/null
