@@ -0,0 +1,257 @@
+// Copyright 2026 SK Productions LLC
+
+#include "chrome/browser/ui/evo_shell/evo_shell_coordinator.h"
+
+#include <array>
+#include <optional>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/escape.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/evo_shell/evo_shell_prefs.h"
+#include "chrome/browser/ui/evo_shell/evo_shell_types.h"
+#include "chrome/browser/ui/tabs/tab_group_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/evo_shell_host_view.h"
+#include "chrome/common/webui_url_constants.h"
+#include "components/prefs/pref_service.h"
+#include "components/tab_groups/tab_group_id.h"
+#include "components/tabs/public/tab_group.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace evo::shell {
+namespace {
+
+struct FavoriteDefinition {
+  const char* id;
+  const char* title;
+  const char* url;
+};
+
+constexpr std::array<FavoriteDefinition, 12> kFavorites = {{
+    {"claude", "Claude", "https://claude.ai/"},
+    {"chatgpt", "ChatGPT", "https://chatgpt.com/"},
+    {"github", "GitHub", "https://github.com/"},
+    {"discord", "Discord", "https://discord.com/app"},
+    {"azure", "Azure", "https://portal.azure.com/"},
+    {"reddit", "Reddit", "https://www.reddit.com/"},
+    {"clickup", "ClickUp", "https://app.clickup.com/"},
+    {"drive", "Google Drive", "https://drive.google.com/"},
+    {"gmail", "Gmail", "https://mail.google.com/"},
+    {"calendar", "Google Calendar", "https://calendar.google.com/"},
+    {"figma", "Figma", "https://www.figma.com/"},
+    {"codex", "Codex", "https://chatgpt.com/codex"},
+}};
+
+constexpr std::array<const char*, 5> kThemeModes = {"agent", "personal", "work",
+                                                    "media", "focus"};
+
+std::string FaviconUrl(const GURL& page_url) {
+  if (!page_url.is_valid()) {
+    return "chrome://resources/images/icon_globe.svg";
+  }
+  return "chrome://favicon2/?size=32&scale_factor=2x&page_url=" +
+         base::EscapeQueryParamValue(page_url.spec(), true);
+}
+
+std::string TabId(tabs::TabInterface* tab) {
+  return base::NumberToString(tab->GetHandle().raw_value());
+}
+
+TabSnapshot SnapshotTab(TabStripModel* model, int index) {
+  tabs::TabInterface* tab = model->GetTabAtIndex(index);
+  content::WebContents* contents = model->GetWebContentsAt(index);
+  const GURL& url = contents->GetLastCommittedURL();
+  return {.id = TabId(tab),
+          .title = base::UTF16ToUTF8(
+              contents->GetTitle().empty() ? u"New Tab" : contents->GetTitle()),
+          .url =
+              url.SchemeIsHTTPOrHTTPS() ? std::string(url.host()) : std::string(),
+          .favicon_url = FaviconUrl(url),
+          .active = index == model->active_index(),
+          .loading = contents->IsLoading(),
+          .pinned = tab->IsPinned()};
+}
+
+}  // namespace
+
+EvoShellCoordinator::EvoShellCoordinator(Browser* browser,
+                                         Profile* profile,
+                                         EvoShellHostView* host)
+    : browser_(browser), profile_(profile), host_(host) {
+  browser_->tab_strip_model()->AddObserver(this);
+  host_->SetSidebarCollapsed(
+      profile_->GetPrefs()->GetBoolean(prefs::kSidebarCollapsed));
+}
+
+EvoShellCoordinator::~EvoShellCoordinator() {
+  browser_->tab_strip_model()->RemoveObserver(this);
+}
+
+base::DictValue EvoShellCoordinator::BuildSnapshot() const {
+  TabStripModel* model = browser_->tab_strip_model();
+  ShellSnapshot snapshot;
+  snapshot.sidebar_collapsed = host_->sidebar_collapsed();
+  snapshot.active_rail_target = active_rail_target_;
+
+  const auto groups = model->group_model()->ListTabGroups();
+  const std::optional<tab_groups::TabGroupId> focused =
+      model->GetFocusedGroup();
+  for (size_t index = 0; index < groups.size(); ++index) {
+    TabGroup* group = model->group_model()->GetTabGroup(groups[index]);
+    const std::u16string& title = group->visual_data()->title();
+    snapshot.spaces.push_back(
+        {.id = groups[index].ToString(),
+         .name = base::UTF16ToUTF8(
+             title.empty() ? u"Space " + base::NumberToString16(index + 1)
+                           : title),
+         .mode = kThemeModes[index % kThemeModes.size()]});
+  }
+  if (focused) {
+    snapshot.active_space_id = focused->ToString();
+  } else if (!snapshot.spaces.empty()) {
+    snapshot.active_space_id = snapshot.spaces.front().id;
+  }
+
+  for (const auto& favorite : kFavorites) {
+    snapshot.favorites.push_back(
+        {.id = favorite.id,
+         .title = favorite.title,
+         .favicon_url = FaviconUrl(GURL(favorite.url))});
+  }
+
+  for (int index = 0; index < model->count(); ++index) {
+    tabs::TabInterface* tab = model->GetTabAtIndex(index);
+    if (tab->IsPinned()) {
+      snapshot.pinned_tabs.push_back(SnapshotTab(model, index));
+      continue;
+    }
+    if (!focused || tab->GetGroup() == focused) {
+      snapshot.open_tabs.push_back(SnapshotTab(model, index));
+    }
+  }
+  return snapshot.ToValue();
+}
+
+base::DictValue EvoShellCoordinator::DispatchAction(
+    const base::DictValue& action) {
+  const std::string* type = action.FindString("type");
+  if (!type) {
+    return BuildSnapshot();
+  }
+
+  TabStripModel* model = browser_->tab_strip_model();
+  if (*type == "activateTab") {
+    const std::string* id = action.FindString("tabId");
+    const int index = id ? FindTabIndex(*id) : TabStripModel::kNoTab;
+    if (index != TabStripModel::kNoTab) {
+      model->ActivateTabAt(index);
+    }
+  } else if (*type == "closeTab") {
+    const std::string* id = action.FindString("tabId");
+    const int index = id ? FindTabIndex(*id) : TabStripModel::kNoTab;
+    if (index != TabStripModel::kNoTab && !model->IsTabPinned(index)) {
+      model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
+    }
+  } else if (*type == "newTab") {
+    chrome::AddTabAt(browser_, GURL(), -1, true);
+  } else if (*type == "openFavorite") {
+    const std::string* id = action.FindString("favoriteId");
+    if (id) {
+      for (const auto& favorite : kFavorites) {
+        if (*id == favorite.id) {
+          chrome::AddTabAt(browser_, GURL(favorite.url), -1, true);
+          break;
+        }
+      }
+    }
+  } else if (*type == "selectSpace") {
+    const std::string* id = action.FindString("spaceId");
+    if (id) {
+      const auto groups = model->group_model()->ListTabGroups();
+      for (size_t index = 0; index < groups.size(); ++index) {
+        if (*id == groups[index].ToString()) {
+          model->SetFocusedGroup(groups[index]);
+          host_->SetTheme(static_cast<EvoNativeTheme>(index % 5));
+          break;
+        }
+      }
+    }
+  } else if (*type == "setSidebarCollapsed") {
+    const std::optional<bool> collapsed = action.FindBool("collapsed");
+    if (collapsed) {
+      host_->SetSidebarCollapsed(*collapsed);
+      profile_->GetPrefs()->SetBoolean(prefs::kSidebarCollapsed, *collapsed);
+      BrowserView::GetBrowserViewForBrowser(browser_)->InvalidateLayout();
+    }
+  } else if (*type == "selectRailTarget") {
+    const std::string* target = action.FindString("target");
+    if (target) {
+      active_rail_target_ = *target;
+    }
+  }
+
+  ScheduleSnapshotChanged();
+  return BuildSnapshot();
+}
+
+base::CallbackListSubscription EvoShellCoordinator::AddSnapshotChangedCallback(
+    base::RepeatingCallback<void(const base::DictValue&)> callback) {
+  return snapshot_callbacks_.Add(std::move(callback));
+}
+
+void EvoShellCoordinator::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  ScheduleSnapshotChanged();
+}
+
+void EvoShellCoordinator::OnTabChangedAt(tabs::TabInterface* tab,
+                                         int index,
+                                         TabChangeType change_type) {
+  ScheduleSnapshotChanged();
+}
+
+void EvoShellCoordinator::OnTabGroupFocusChanged(
+    std::optional<tab_groups::TabGroupId> new_focused_group_id,
+    std::optional<tab_groups::TabGroupId> old_focused_group_id) {
+  ScheduleSnapshotChanged();
+}
+
+int EvoShellCoordinator::FindTabIndex(const std::string& id) const {
+  TabStripModel* model = browser_->tab_strip_model();
+  for (int index = 0; index < model->count(); ++index) {
+    if (TabId(model->GetTabAtIndex(index)) == id) {
+      return index;
+    }
+  }
+  return TabStripModel::kNoTab;
+}
+
+void EvoShellCoordinator::ScheduleSnapshotChanged() {
+  if (notification_scheduled_) {
+    return;
+  }
+  notification_scheduled_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&EvoShellCoordinator::NotifySnapshotChanged,
+                                weak_ptr_factory_.GetWeakPtr()));
+}
+
+void EvoShellCoordinator::NotifySnapshotChanged() {
+  notification_scheduled_ = false;
+  const base::DictValue snapshot = BuildSnapshot();
+  snapshot_callbacks_.Notify(snapshot);
+}
+
+}  // namespace evo::shell
