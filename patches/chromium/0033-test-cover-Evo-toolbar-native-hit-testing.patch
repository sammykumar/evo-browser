diff --git a/chrome/browser/ui/views/frame/evo_shell_interactive_uitest.cc b/chrome/browser/ui/views/frame/evo_shell_interactive_uitest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..046d71060194489bef3ca24bdcbafc51a0eca0f6
--- /dev/null
+++ b/chrome/browser/ui/views/frame/evo_shell_interactive_uitest.cc
@@ -0,0 +1,54 @@
+// Copyright 2026 SK Productions LLC
+
+#include "base/run_loop.h"
+#include "base/test/run_until.h"
+#include "base/test/scoped_feature_list.h"
+#include "chrome/browser/ui/evo_shell/evo_shell_features.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/evo_shell_host_view.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "ui/base/test/ui_controls.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/widget/widget.h"
+
+class EvoShellInteractiveUiTest : public InProcessBrowserTest {
+ protected:
+  base::test::ScopedFeatureList scoped_feature_list_{
+      evo::features::kEvoHybridBrowserShell};
+};
+
+IN_PROC_BROWSER_TEST_F(EvoShellInteractiveUiTest,
+                       ToolbarSurfaceAcceptsMouseClicks) {
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser());
+  ASSERT_TRUE(browser_view);
+  auto* host = browser_view->evo_shell_host_for_testing();
+  ASSERT_TRUE(host);
+  ASSERT_TRUE(base::test::RunUntil([&] { return host->surfaces_ready(); }));
+  views::WebView* toolbar = host->toolbar_web_view_for_testing();
+  ASSERT_TRUE(toolbar);
+  content::WebContents* toolbar_contents = toolbar->GetWebContents();
+  ASSERT_TRUE(toolbar_contents);
+  ASSERT_TRUE(content::WaitForLoadStop(toolbar_contents));
+  ASSERT_TRUE(content::ExecJs(toolbar_contents,
+                              "document.activeElement.blur();"));
+  EXPECT_EQ("BODY", content::EvalJs(
+                        toolbar_contents, "document.activeElement.tagName"));
+
+  const gfx::Point toolbar_center = toolbar->GetBoundsInScreen().CenterPoint();
+  base::RunLoop move_loop;
+  ASSERT_TRUE(ui_controls::SendMouseMoveNotifyWhenDone(
+      toolbar_center.x(), toolbar_center.y(), move_loop.QuitClosure(),
+      browser_view->GetWidget()->GetNativeWindow()));
+  move_loop.Run();
+  base::RunLoop click_loop;
+  ASSERT_TRUE(ui_controls::SendMouseEventsNotifyWhenDone(
+      ui_controls::LEFT, ui_controls::DOWN | ui_controls::UP,
+      click_loop.QuitClosure()));
+  click_loop.Run();
+
+  EXPECT_EQ("INPUT", content::EvalJs(
+                         toolbar_contents, "document.activeElement.tagName"));
+}
