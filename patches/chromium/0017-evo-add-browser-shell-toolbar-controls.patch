@@ -301,6 +301,8 @@ class BrowserView : public BrowserWindow,
   evo::shell::EvoShellCoordinator* evo_shell_coordinator() const {
     return evo_shell_coordinator_.get();
   }
+  void ToggleEvoSidebar();
+  void ToggleEvoRightRail();
 
   ProjectsPanelView* projects_panel_container_for_testing() const {
     return projects_panel_container_;
diff --git a/chrome/browser/ui/views/toolbar/toolbar_view.cc b/chrome/browser/ui/views/toolbar/toolbar_view.cc
