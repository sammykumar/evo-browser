From 84ff21a85467f0768fc6cb0bf8decaa4ea67f159 Mon Sep 17 00:00:00 2001
From: Sam Kumar <sammy.kumar@icloud.com>
Date: Sun, 19 Jul 2026 16:20:15 -0500
Subject: [PATCH 17/32] evo: add browser shell toolbar controls

---
 .../ui/evo_shell/evo_shell_coordinator.cc     | 20 ++++++++++--
 .../ui/evo_shell/evo_shell_coordinator.h      |  2 ++
 .../browser/ui/evo_shell/evo_shell_prefs.cc   |  1 +
 chrome/browser/ui/evo_shell/evo_shell_prefs.h |  1 +
 chrome/browser/ui/views/frame/browser_view.cc | 14 +++++++++
 chrome/browser/ui/views/frame/browser_view.h  |  2 ++
 .../browser/ui/views/toolbar/toolbar_view.cc  | 31 +++++++++++++++++++
 .../browser/ui/views/toolbar/toolbar_view.h   |  5 +++
 8 files changed, 73 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/ui/evo_shell/evo_shell_coordinator.cc b/chrome/browser/ui/evo_shell/evo_shell_coordinator.cc
index bd27abdde1cb9c4589ef431bddb826f08a75e16d..192bca003583ceda0deddfbba7b2ee0b630bb9ba 100644
--- a/chrome/browser/ui/evo_shell/evo_shell_coordinator.cc
+++ b/chrome/browser/ui/evo_shell/evo_shell_coordinator.cc
@@ -91,6 +91,8 @@ EvoShellCoordinator::EvoShellCoordinator(Browser* browser,
   browser_->tab_strip_model()->AddObserver(this);
   host_->SetSidebarCollapsed(
       profile_->GetPrefs()->GetBoolean(prefs::kSidebarCollapsed));
+  host_->SetRightRailVisible(
+      profile_->GetPrefs()->GetBoolean(prefs::kRightRailVisible));
 }
 
 EvoShellCoordinator::~EvoShellCoordinator() {
@@ -196,9 +198,7 @@ base::DictValue EvoShellCoordinator::DispatchAction(
   } else if (*type == "setSidebarCollapsed") {
     const std::optional<bool> collapsed = action.FindBool("collapsed");
     if (collapsed) {
-      host_->SetSidebarCollapsed(*collapsed);
-      profile_->GetPrefs()->SetBoolean(prefs::kSidebarCollapsed, *collapsed);
-      BrowserView::GetBrowserViewForBrowser(browser_)->InvalidateLayout();
+      SetSidebarCollapsed(*collapsed);
     }
   } else if (*type == "selectRailTarget") {
     const std::string* target = action.FindString("target");
@@ -211,6 +211,20 @@ base::DictValue EvoShellCoordinator::DispatchAction(
   return BuildSnapshot();
 }
 
+void EvoShellCoordinator::SetSidebarCollapsed(bool collapsed) {
+  host_->SetSidebarCollapsed(collapsed);
+  profile_->GetPrefs()->SetBoolean(prefs::kSidebarCollapsed, collapsed);
+  BrowserView::GetBrowserViewForBrowser(browser_)->InvalidateLayout();
+  ScheduleSnapshotChanged();
+}
+
+void EvoShellCoordinator::SetRightRailVisible(bool visible) {
+  host_->SetRightRailVisible(visible);
+  profile_->GetPrefs()->SetBoolean(prefs::kRightRailVisible, visible);
+  BrowserView::GetBrowserViewForBrowser(browser_)->InvalidateLayout();
+  ScheduleSnapshotChanged();
+}
+
 base::CallbackListSubscription EvoShellCoordinator::AddSnapshotChangedCallback(
     base::RepeatingCallback<void(const base::DictValue&)> callback) {
   return snapshot_callbacks_.Add(std::move(callback));
diff --git a/chrome/browser/ui/evo_shell/evo_shell_coordinator.h b/chrome/browser/ui/evo_shell/evo_shell_coordinator.h
index 4c22ff137f147328b8d628d9bcfab72887640e6a..551df366f8a500aea41c42f93a7f3eaeabde3615 100644
--- a/chrome/browser/ui/evo_shell/evo_shell_coordinator.h
+++ b/chrome/browser/ui/evo_shell/evo_shell_coordinator.h
@@ -31,6 +31,8 @@ class EvoShellCoordinator : public TabStripModelObserver {
 
   base::DictValue BuildSnapshot() const;
   base::DictValue DispatchAction(const base::DictValue& action);
+  void SetSidebarCollapsed(bool collapsed);
+  void SetRightRailVisible(bool visible);
   base::CallbackListSubscription AddSnapshotChangedCallback(
       base::RepeatingCallback<void(const base::DictValue&)> callback);
 
diff --git a/chrome/browser/ui/evo_shell/evo_shell_prefs.cc b/chrome/browser/ui/evo_shell/evo_shell_prefs.cc
index c3b14d2465df4d583b311dd75618a4b0a3414a52..039d1234d8f392bff0ed1aa18f9e3bcbf0fecf5b 100644
--- a/chrome/browser/ui/evo_shell/evo_shell_prefs.cc
+++ b/chrome/browser/ui/evo_shell/evo_shell_prefs.cc
@@ -8,6 +8,7 @@ namespace evo::shell::prefs {
 
 void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
   registry->RegisterBooleanPref(kSidebarCollapsed, false);
+  registry->RegisterBooleanPref(kRightRailVisible, true);
 }
 
 }  // namespace evo::shell::prefs
diff --git a/chrome/browser/ui/evo_shell/evo_shell_prefs.h b/chrome/browser/ui/evo_shell/evo_shell_prefs.h
index bebf46de76aba892c7b447626fb4cd938580ef8f..2dad7c33a953283690e1aab44cc42f3e2593a07d 100644
--- a/chrome/browser/ui/evo_shell/evo_shell_prefs.h
+++ b/chrome/browser/ui/evo_shell/evo_shell_prefs.h
@@ -10,6 +10,7 @@ class PrefRegistrySyncable;
 namespace evo::shell::prefs {
 
 inline constexpr char kSidebarCollapsed[] = "evo.shell.sidebar_collapsed";
+inline constexpr char kRightRailVisible[] = "evo.shell.right_rail_visible";
 
 void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
 
diff --git a/chrome/browser/ui/views/frame/browser_view.cc b/chrome/browser/ui/views/frame/browser_view.cc
index 52268c13aea02aa9c3fc319267d4d8837544a87c..e44de2566359eb231b409dece4a8d0f535b885e7 100644
--- a/chrome/browser/ui/views/frame/browser_view.cc
+++ b/chrome/browser/ui/views/frame/browser_view.cc
@@ -5609,6 +5609,20 @@ void BrowserView::OnEvoShellReady() {
   InvalidateLayout();
 }
 
+void BrowserView::ToggleEvoSidebar() {
+  if (evo_shell_host_ && evo_shell_coordinator_) {
+    evo_shell_coordinator_->SetSidebarCollapsed(
+        !evo_shell_host_->sidebar_collapsed());
+  }
+}
+
+void BrowserView::ToggleEvoRightRail() {
+  if (evo_shell_host_ && evo_shell_coordinator_) {
+    evo_shell_coordinator_->SetRightRailVisible(
+        !evo_shell_host_->right_rail_visible());
+  }
+}
+
 void BrowserView::OnEvoShellFallback(evo::EvoShellFallbackReason reason) {
   evo_shell_active_ = false;
   if (evo_shell_host_) {
diff --git a/chrome/browser/ui/views/frame/browser_view.h b/chrome/browser/ui/views/frame/browser_view.h
index aa5c6e64422701d539b5694f95f30b2ec39cd8fb..fe30aa232f2309c9f490f00851a362ede4d1f057 100644
