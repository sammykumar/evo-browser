@@ -74,6 +76,7 @@
 #include "chrome/browser/ui/views/extensions/extensions_toolbar_coordinator.h"
 #include "chrome/browser/ui/views/extensions/extensions_toolbar_desktop.h"
 #include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/evo_shell_host_view.h"
 #include "chrome/browser/ui/views/frame/custom_corners_background.h"
 #include "chrome/browser/ui/views/frame/top_container_view.h"
 #include "chrome/browser/ui/views/glic/glic_button_interface.h"
@@ -404,6 +407,13 @@ void ToolbarView::Init() {
 #endif
 
   // Always add children in order from left to right, for accessibility.
+  if (base::FeatureList::IsEnabled(evo::features::kEvoHybridBrowserShell)) {
+    evo_sidebar_toggle_ = AddChildView(std::make_unique<ToolbarButton>(
+        base::BindRepeating(&ToolbarView::OnEvoSidebarToggle,
+                            base::Unretained(this))));
+    evo_sidebar_toggle_->SetVectorIcon(kDockToRightIcon);
+    evo_sidebar_toggle_->SetTooltipText(u"Show sidebar");
+  }
   if (!features::IsWebUIBackForwardButtonEnabled()) {
     back_ = AddChildView(std::make_unique<BackForwardButton>(
         BackForwardButton::Direction::kBack,
@@ -463,6 +473,14 @@ void ToolbarView::Init() {
     location_bar_ = toolbar_webview_->GetLocationBar();
   }
 
+  if (base::FeatureList::IsEnabled(evo::features::kEvoHybridBrowserShell)) {
+    evo_right_rail_toggle_ = AddChildView(std::make_unique<ToolbarButton>(
+        base::BindRepeating(&ToolbarView::OnEvoRightRailToggle,
+                            base::Unretained(this))));
+    evo_right_rail_toggle_->SetVectorIcon(kDockToLeftIcon);
+    evo_right_rail_toggle_->SetTooltipText(u"Toggle tool rail");
+  }
+
   bool is_glic_left_of_profile =
       features::kGlicToolbarButtonLocationParam.Get() ==
           features::GlicToolbarButtonLocation::kLeftOfProfileChip ||
@@ -1615,6 +1633,11 @@ void ToolbarView::InitLayout() {
 void ToolbarView::LayoutCommon() {
   DCHECK(display_mode_ == DisplayMode::kNormal);
 
+  if (evo_sidebar_toggle_) {
+    auto* host = browser_view_->evo_shell_host_for_testing();
+    evo_sidebar_toggle_->SetVisible(host && host->sidebar_collapsed());
+  }
+
   gfx::Insets interior_margin =
       GetLayoutInsets(LayoutInset::TOOLBAR_INTERIOR_MARGIN);
 
@@ -1676,6 +1699,14 @@ void ToolbarView::LayoutCommon() {
   // Cast button visibility is controlled externally.
 }
 
+void ToolbarView::OnEvoSidebarToggle(const ui::Event& event) {
+  browser_view_->ToggleEvoSidebar();
+}
+
+void ToolbarView::OnEvoRightRailToggle(const ui::Event& event) {
+  browser_view_->ToggleEvoRightRail();
+}
