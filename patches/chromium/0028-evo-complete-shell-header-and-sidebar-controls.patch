 suite('EvoShellComponents', () => {
+  test('SpaceHeaderUsesActiveAccentAndProfileBadge', () => {
+    const view = sidebar(snapshot(), () => {});
+    assertTrue(view.querySelector('.space-avatar') !== null);
+    assertEquals(
+        'Default', view.querySelector('.profile-badge')!.textContent);
+  });
+
+  test('CollapsedToolbarCanReopenSidebar', () => {
+    const state = snapshot();
+    state.sidebarCollapsed = true;
+    const actions: EvoShellAction[] = [];
+    const view = toolbar(state, action => actions.push(action));
+
+    const expand = view.querySelector('.sidebar-expand') as HTMLButtonElement;
+    assertTrue(expand !== null);
+    expand.click();
+    assertEquals('setSidebarCollapsed', actions[0]!.type);
+    assertFalse((actions[0] as {
+      type: 'setSidebarCollapsed',
+      collapsed: boolean,
+    }).collapsed);
+  });
+
   test('PinsSpaceSwitcherToSidebarBottom', () => {
     const view = sidebar(snapshot(), () => {});
     assertEquals('space-switcher', view.lastElementChild!.className);
