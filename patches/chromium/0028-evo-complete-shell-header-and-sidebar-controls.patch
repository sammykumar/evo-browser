 }
 
-.agent-orb {
+.space-avatar {
   width: 18px;
   height: 18px;
   flex: 0 0 auto;
   border: 1px solid rgba(255, 255, 255, .3);
   border-radius: var(--radius-full);
-  background: linear-gradient(135deg, #57dcd6, #8f7bf3);
-  box-shadow: 0 0 14px rgba(87, 220, 214, .28);
+  background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
+  box-shadow: 0 0 14px color-mix(in srgb, var(--accent-1) 28%, transparent);
