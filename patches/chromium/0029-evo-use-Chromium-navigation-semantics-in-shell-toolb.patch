+IN_PROC_BROWSER_TEST_F(EvoShellUIBrowserTest,
+                       AddressQueryUsesDefaultSearchProvider) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  TemplateURLService* service =
+      TemplateURLServiceFactory::GetForProfile(browser()->profile());
+  search_test_utils::WaitForTemplateURLServiceToLoad(service);
+
+  TemplateURLData data;
+  data.SetShortName(u"Evo test search");
+  data.SetKeyword(data.short_name());
+  data.SetURL(embedded_test_server()
+                  ->GetURL("search.test", "/echo?q={searchTerms}")
+                  .spec());
+  TemplateURL* provider = service->Add(std::make_unique<TemplateURL>(data));
+  ASSERT_TRUE(provider);
+  service->SetUserSelectedDefaultSearchProvider(provider);
+  const GURL expected =
+      service->GenerateSearchURLForDefaultSearchProvider(u"evo browser query");
+
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser());
+  ASSERT_TRUE(browser_view);
+  auto* coordinator = browser_view->evo_shell_coordinator();
+  ASSERT_TRUE(coordinator);
+  content::WebContents* contents =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  ASSERT_TRUE(contents);
+  content::TestNavigationObserver observer(contents);
+  base::DictValue action;
+  action.Set("type", "navigate");
+  action.Set("url", "evo browser query");
+  coordinator->DispatchAction(action);
+  observer.Wait();
+
+  EXPECT_EQ(expected, contents->GetLastCommittedURL());
+}
