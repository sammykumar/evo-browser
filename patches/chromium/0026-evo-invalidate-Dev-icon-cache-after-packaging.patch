From 05a4cd8bbeb38a0e336256fec3ddaa5427144634 Mon Sep 17 00:00:00 2001
From: Sam Kumar <sammy.kumar@icloud.com>
Date: Tue, 21 Jul 2026 06:55:18 -0500
Subject: [PATCH 26/35] evo: invalidate Dev icon cache after packaging

---
 evo/build-dev.sh | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/evo/build-dev.sh b/evo/build-dev.sh
index cab860dab3549a304a1fdcf3824c2366a9e3797f..e7ff5b4add7ef860040b00e30dbde64ce4bfdb27 100755
--- a/evo/build-dev.sh
+++ b/evo/build-dev.sh
@@ -39,4 +39,8 @@ cp "${src_dir}/chrome/app/theme/chromium/mac/Assets_dev.car" \
     "${dev_app}/Contents/Resources/Assets.car"
 
 "${evo_dir}/sign.sh" "${dev_app}"
+# Finder keys its app-icon cache to the bundle metadata. Packaging replaces
+# icon resources inside an existing bundle, so make that change visible at the
+# bundle boundary after signing.
+touch "${dev_app}"
 echo "Development app: ${dev_app}"
