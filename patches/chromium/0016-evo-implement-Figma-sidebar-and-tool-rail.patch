+import {evoIcon} from '../evo_icon.js';
+import {tabItem} from './tab_item.js';
+import type {EvoShellFolder} from '../types.js';
+import type {TabItemCallbacks} from './tab_item.js';
+
+export function folderRow(
+    folder: EvoShellFolder, callbacks: TabItemCallbacks): HTMLDivElement {
+  const container = document.createElement('div');
+  container.className = 'folder-row';
+  const header = document.createElement('div');
+  header.className = 'list-row folder-header';
+  header.append(evoIcon('folder', 17));
+  const title = document.createElement('span');
+  title.textContent = folder.title;
+  header.append(title);
+  container.append(header);
+
+  const children = document.createElement('div');
+  children.className = 'folder-children';
+  for (const tab of folder.children) {
+    children.append(tabItem({...tab, pinned: true}, callbacks));
+  }
+  container.append(children);
+  return container;
+}
