+export interface EvoShellTab {
+  id: string;
+  title: string;
+  url?: string;
+  faviconUrl: string;
+  active: boolean;
+  loading: boolean;
+  pinned: boolean;
+}
+
+export interface EvoShellFavorite {
+  id: string;
+  title: string;
+  faviconUrl: string;
+}
+
+export interface EvoShellFolder {
+  id: string;
+  title: string;
+  children: EvoShellTab[];
+}
+
+export interface EvoShellSpace {
+  id: string;
+  name: string;
+  mode: EvoThemeMode;
+  badge?: number;
+}
+
+export interface EvoShellSnapshot {
+  activeSpaceId: string;
+  spaces: EvoShellSpace[];
+  favorites: EvoShellFavorite[];
+  pinnedTabs: EvoShellTab[];
+  folders: EvoShellFolder[];
+  openTabs: EvoShellTab[];
+  sidebarCollapsed: boolean;
+  activeRailTarget: string;
+}
+
+export type EvoSidebarAction =
+    {type: 'activateTab', tabId: string}|
+    {type: 'closeTab', tabId: string}|
+    {type: 'newTab'}|
+    {type: 'openFavorite', favoriteId: string}|
+    {type: 'selectSpace', spaceId: string}|
+    {type: 'setSidebarCollapsed', collapsed: boolean};
+
+export type EvoRailAction = {type: 'selectRailTarget', target: string};
+export type EvoShellAction = EvoSidebarAction|EvoRailAction;
