+import {iconButton} from './icon_button.js';
+import type {EvoShellSpace} from '../types.js';
+
+export function spaceHeader(
+    space: EvoShellSpace|undefined, onCollapse: () => void): HTMLElement {
+  const header = document.createElement('header');
+  header.className = 'space-header';
+  const identity = document.createElement('div');
+  identity.className = 'space-identity';
+  const orb = document.createElement('span');
+  orb.className = 'agent-orb';
+  orb.setAttribute('aria-hidden', 'true');
+  const title = document.createElement('strong');
+  title.textContent = space?.name || 'Agent';
+  identity.append(orb, title);
+  header.append(identity, iconButton('panel-left', 'Collapse sidebar', onCollapse));
+  return header;
+}
diff --git a/chrome/browser/resources/evo_shell/components/space_switcher.ts b/chrome/browser/resources/evo_shell/components/space_switcher.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e5d52260250b2cbfb004139a53130aeacf1c5ab5
--- /dev/null
+++ b/chrome/browser/resources/evo_shell/components/space_switcher.ts
@@ -0,0 +1,37 @@
+// Copyright 2026 SK Productions LLC
+
+import {badge} from './badge.js';
+import type {EvoShellSpace} from '../types.js';
+
+export function spaceSwitcher(
+    spaces: EvoShellSpace[], activeSpaceId: string,
+    onSelect: (id: string) => void): HTMLElement {
+  const nav = document.createElement('nav');
+  nav.className = 'space-switcher';
+  nav.setAttribute('aria-label', 'Spaces');
+  for (const space of spaces) {
+    const button = document.createElement('button');
+    button.className = 'space-switcher-item';
+    button.classList.toggle('is-active', space.id === activeSpaceId);
+    button.type = 'button';
+    button.title = space.name;
+    button.setAttribute('aria-label', `Switch to ${space.name}`);
+    button.dataset['mode'] = space.mode;
+    const dot = document.createElement('span');
+    dot.className = 'space-dot';
+    button.append(dot);
+    if (space.badge) {
+      button.append(badge(space.badge));
+    }
+    button.addEventListener('click', () => onSelect(space.id));
+    nav.append(button);
+  }
+  const add = document.createElement('button');
+  add.className = 'space-add-placeholder';
+  add.type = 'button';
+  add.disabled = true;
+  add.textContent = '+';
+  add.title = 'Space management is coming later';
+  nav.append(add);
+  return nav;
+}
diff --git a/chrome/browser/resources/evo_shell/components/tab_item.ts b/chrome/browser/resources/evo_shell/components/tab_item.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f8878827184d192d4f72897f74f06edabce752bc
--- /dev/null
+++ b/chrome/browser/resources/evo_shell/components/tab_item.ts
@@ -0,0 +1,59 @@
+// Copyright 2026 SK Productions LLC
+
+import {evoIcon} from '../evo_icon.js';
+import type {EvoShellTab} from '../types.js';
+
+export interface TabItemCallbacks {
+  activate(id: string): void;
+  close(id: string): void;
+}
+
+export function tabItem(
+    tab: EvoShellTab, callbacks: TabItemCallbacks): HTMLDivElement {
+  const row = document.createElement('div');
+  row.className = 'tab-item';
+  row.classList.toggle('is-active', tab.active);
+  row.classList.toggle('is-loading', tab.loading);
+  row.classList.toggle('is-pinned', tab.pinned);
+  row.dataset['tabId'] = tab.id;
+
+  const activate = document.createElement('button');
+  activate.className = 'tab-item-main';
+  activate.type = 'button';
+  activate.setAttribute('aria-label', `Open ${tab.title}`);
+
+  const favicon = document.createElement('img');
+  favicon.className = 'tab-favicon';
+  favicon.alt = '';
+  favicon.src = tab.faviconUrl;
+  favicon.addEventListener(
+      'error', () => favicon.replaceWith(evoIcon('globe', 16)), {once: true});
+  activate.append(favicon);
+
+  const text = document.createElement('span');
+  text.className = 'tab-item-text';
+  const title = document.createElement('span');
+  title.className = 'tab-item-title';
+  title.textContent = tab.title || 'New Tab';
+  text.append(title);
+  if (tab.url) {
+    const subtitle = document.createElement('span');
+    subtitle.className = 'tab-item-subtitle';
+    subtitle.textContent = tab.url;
+    text.append(subtitle);
+  }
+  activate.append(text);
+  activate.addEventListener('click', () => callbacks.activate(tab.id));
+  row.append(activate);
+
+  if (!tab.pinned) {
+    const close = document.createElement('button');
+    close.className = 'tab-close';
+    close.type = 'button';
+    close.setAttribute('aria-label', `Close ${tab.title}`);
+    close.append(evoIcon('x', 14));
+    close.addEventListener('click', () => callbacks.close(tab.id));
+    row.append(close);
+  }
+  return row;
+}
diff --git a/chrome/browser/resources/evo_shell/evo_icon.ts b/chrome/browser/resources/evo_shell/evo_icon.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6e34b1e92b7b2d552c1b7533c28e02400fdaf4e3
