@@ -0,0 +1,46 @@
+// Copyright 2026 SK Productions LLC
+
+import {railItem} from './rail_item.js';
+import type {RailItemDefinition} from './rail_item.js';
+import type {EvoShellAction, EvoShellSnapshot} from '../types.js';
+
+// Placeholder information architecture. Keeping this declarative lets the AI,
+// split-view, and utility epics replace targets without restructuring the rail.
+export const TOP_RAIL_ITEMS: readonly RailItemDefinition[] = [
+  {icon: 'sparkles', label: 'Ask Evo', target: 'ask-evo'},
+  {icon: 'columns-2', label: 'Split', target: 'split'},
+  {icon: 'file-text', label: 'Notes', target: 'notes'},
+  {icon: 'bookmark', label: 'Saved', target: 'saved'},
+  {icon: 'download', label: 'Downloads', target: 'downloads'},
+  {icon: 'clock', label: 'History', target: 'history'},
+  {icon: 'puzzle', label: 'Extensions', target: 'extensions'},
+];
+
+export const BOTTOM_RAIL_ITEMS: readonly RailItemDefinition[] = [
+  {icon: 'settings-2', label: 'Settings', target: 'settings'},
+  {icon: 'ellipsis', label: 'More', target: 'more'},
+];
+
+export function rightRail(
+    snapshot: EvoShellSnapshot,
+    dispatch: (action: EvoShellAction) => void): HTMLElement {
+  const shell = document.createElement('nav');
+  shell.className = 'evo-shell-surface right-rail';
+  shell.dataset['surface'] = 'rail';
+  shell.setAttribute('aria-label', 'Evo tools');
+
+  const group = document.createElement('div');
+  group.className = 'rail-group';
+  const bottom = document.createElement('div');
+  bottom.className = 'rail-group rail-group-bottom';
+  const select = (target: string) =>
+      dispatch({type: 'selectRailTarget', target});
+  for (const item of TOP_RAIL_ITEMS) {
+    group.append(railItem(item, snapshot.activeRailTarget === item.target, select));
+  }
+  for (const item of BOTTOM_RAIL_ITEMS) {
+    bottom.append(railItem(item, snapshot.activeRailTarget === item.target, select));
+  }
+  shell.append(group, bottom);
+  return shell;
+}
