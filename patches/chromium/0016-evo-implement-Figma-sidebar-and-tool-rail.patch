diff --git a/chrome/browser/resources/evo_shell/browser_proxy.ts b/chrome/browser/resources/evo_shell/browser_proxy.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ac79e6db506194a2294bd3284c0ad5d5015cb3b6
--- /dev/null
+++ b/chrome/browser/resources/evo_shell/browser_proxy.ts
@@ -0,0 +1,34 @@
+// Copyright 2026 SK Productions LLC
+
+import {addWebUiListener, sendWithPromise} from 'chrome://resources/js/cr.js';
+
+import type {EvoShellAction, EvoShellSnapshot} from './types.js';
+import type {EvoShellSurface} from './surface.js';
+
+export interface EvoShellBrowserProxy {
+  getSnapshot(): Promise<EvoShellSnapshot>;
+  dispatch(action: EvoShellAction): Promise<EvoShellSnapshot>;
+  ready(surface: EvoShellSurface): Promise<void>;
+  addSnapshotListener(listener: (snapshot: EvoShellSnapshot) => void): void;
+}
+
+class EvoShellBrowserProxyImpl implements EvoShellBrowserProxy {
+  getSnapshot(): Promise<EvoShellSnapshot> {
+    return sendWithPromise('getEvoShellSnapshot');
+  }
+
+  dispatch(action: EvoShellAction): Promise<EvoShellSnapshot> {
+    return sendWithPromise('dispatchEvoShellAction', action);
+  }
+
+  ready(surface: EvoShellSurface): Promise<void> {
+    return sendWithPromise('evoShellReady', surface);
+  }
+
+  addSnapshotListener(listener: (snapshot: EvoShellSnapshot) => void): void {
+    addWebUiListener('evo-shell-snapshot-changed', listener);
+  }
+}
+
+export const evoShellBrowserProxy: EvoShellBrowserProxy =
+    new EvoShellBrowserProxyImpl();
