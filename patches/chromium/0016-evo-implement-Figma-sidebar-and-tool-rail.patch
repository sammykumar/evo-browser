+// Copyright 2026 SK Productions LLC
+
+import {evoIcon} from '../evo_icon.js';
+import type {EvoShellFavorite} from '../types.js';
+
+export function faviconTile(
+    favorite: EvoShellFavorite, onOpen: (id: string) => void): HTMLButtonElement {
+  const tile = document.createElement('button');
+  tile.className = 'favicon-tile';
+  tile.type = 'button';
+  tile.title = favorite.title;
+  tile.setAttribute('aria-label', favorite.title);
+  const image = document.createElement('img');
+  image.alt = '';
+  image.src = favorite.faviconUrl;
+  image.addEventListener('error', () => image.replaceWith(evoIcon('globe', 17)),
+                         {once: true});
+  tile.append(image);
+  tile.addEventListener('click', () => onOpen(favorite.id));
+  return tile;
+}
