index 0000000000000000000000000000000000000000..5217052b470361d2afb7f2b1fc6da3634ad00b79
--- /dev/null
+++ b/chrome/test/data/webui/evo_shell/evo_shell_components_test.ts
@@ -0,0 +1,52 @@
+// Copyright 2026 SK Productions LLC
+
+import {rightRail, TOP_RAIL_ITEMS} from 'chrome://evo-shell/components/right_rail.js';
+import {sidebar} from 'chrome://evo-shell/components/sidebar.js';
+import type {EvoShellAction, EvoShellSnapshot} from 'chrome://evo-shell/types.js';
+import {assertEquals, assertTrue} from 'chrome://webui-test/chai_assert.js';
+
+function snapshot(): EvoShellSnapshot {
+  return {
+    activeSpaceId: 'default',
+    spaces: [
+      {id: 'default', name: 'Agent', mode: 'agent'},
+      {id: 'work', name: 'Work', mode: 'work'},
+    ],
+    favorites: [{id: 'github', title: 'GitHub', faviconUrl: 'github.png'}],
+    pinnedTabs: [],
+    folders: [],
+    openTabs: [{
+      id: 'tab-1', title: 'Evo', faviconUrl: 'evo.png', active: true,
+      loading: false, pinned: false,
+    }],
+    sidebarCollapsed: false,
+    activeRailTarget: 'ask-evo',
+  };
+}
+
+suite('EvoShellComponents', () => {
+  test('PinsSpaceSwitcherToSidebarBottom', () => {
+    const view = sidebar(snapshot(), () => {});
+    assertEquals('space-switcher', view.lastElementChild!.className);
+    assertEquals(2, view.querySelectorAll('.space-switcher-item').length);
+    assertTrue(view.querySelector('.space-switcher-item.is-active') !== null);
+  });
+
+  test('SidebarDispatchesLiveTabAndSpaceActions', () => {
+    const actions: EvoShellAction[] = [];
+    const view = sidebar(snapshot(), action => actions.push(action));
+    (view.querySelector('.tab-item-main') as HTMLButtonElement).click();
+    (view.querySelectorAll('.space-switcher-item')[1] as HTMLButtonElement).click();
+    assertEquals('activateTab', actions[0]!.type);
+    assertEquals('selectSpace', actions[1]!.type);
+  });
+
+  test('RailIsDataDrivenAndHasOneActiveItem', () => {
+    const actions: EvoShellAction[] = [];
+    const view = rightRail(snapshot(), action => actions.push(action));
+    assertEquals(TOP_RAIL_ITEMS.length + 2, view.querySelectorAll('.rail-item').length);
+    assertEquals(1, view.querySelectorAll('.rail-item.is-active').length);
+    (view.querySelector('[data-target="split"]') as HTMLButtonElement).click();
+    assertEquals('selectRailTarget', actions[0]!.type);
+  });
+});
