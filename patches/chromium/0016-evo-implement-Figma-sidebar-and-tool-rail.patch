@@ -0,0 +1,12 @@
+// Copyright 2026 SK Productions LLC
+
+import {createEvoIcon} from './icons.js';
+import type {EvoIconName} from './icons.js';
+
+export function evoIcon(name: EvoIconName, size = 18): SVGSVGElement {
+  const icon = createEvoIcon(name);
+  icon.classList.add('evo-icon');
