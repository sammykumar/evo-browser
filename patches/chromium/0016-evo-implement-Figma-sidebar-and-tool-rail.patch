+
+export interface RailItemDefinition {
+  icon: EvoIconName;
+  label: string;
+  target: string;
+}
+
+export function railItem(
+    item: RailItemDefinition, active: boolean,
+    onSelect: (target: string) => void): HTMLButtonElement {
+  const button = document.createElement('button');
+  button.className = 'rail-item';
+  button.classList.toggle('is-active', active);
+  button.type = 'button';
+  button.dataset['target'] = item.target;
+  button.setAttribute('aria-pressed', String(active));
+  button.append(evoIcon(item.icon, 19));
+  const label = document.createElement('span');
+  label.textContent = item.label;
+  button.append(label);
+  button.addEventListener('click', () => onSelect(item.target));
