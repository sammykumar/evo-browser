@@ -0,0 +1,75 @@
+// Copyright 2026 SK Productions LLC
+
+import {evoIcon} from '../evo_icon.js';
+import {favoritesGrid} from './favorites_grid.js';
+import {folderRow} from './list_row.js';
+import {sectionLabel} from './section_label.js';
+import {spaceHeader} from './space_header.js';
+import {spaceSwitcher} from './space_switcher.js';
+import {tabItem} from './tab_item.js';
+import type {EvoShellAction, EvoShellSnapshot} from '../types.js';
+
+export function sidebar(
+    snapshot: EvoShellSnapshot,
+    dispatch: (action: EvoShellAction) => void): HTMLElement {
+  const shell = document.createElement('main');
+  shell.className = 'evo-shell-surface sidebar';
+  shell.dataset['surface'] = 'sidebar';
+  shell.setAttribute('aria-label', 'Evo sidebar');
+
+  const trafficReservation = document.createElement('div');
+  trafficReservation.className = 'traffic-light-reservation';
+  trafficReservation.setAttribute('aria-hidden', 'true');
+  shell.append(trafficReservation);
+
+  const activeSpace =
+      snapshot.spaces.find(space => space.id === snapshot.activeSpaceId);
+  shell.append(spaceHeader(
+      activeSpace,
+      () => dispatch({type: 'setSidebarCollapsed', collapsed: true})));
+
+  const body = document.createElement('div');
+  body.className = 'sidebar-body';
+  body.append(sectionLabel('FAVORITES'));
+  body.append(favoritesGrid(
+      snapshot.favorites,
+      favoriteId => dispatch({type: 'openFavorite', favoriteId})));
+  body.append(sectionLabel('PINNED'));
+
+  const callbacks = {
+    activate: (tabId: string) => dispatch({type: 'activateTab', tabId}),
+    close: (tabId: string) => dispatch({type: 'closeTab', tabId}),
+  };
+  for (const tab of snapshot.pinnedTabs) {
+    body.append(tabItem(tab, callbacks));
+  }
+  for (const folder of snapshot.folders) {
+    body.append(folderRow(folder, callbacks));
+  }
+
+  const clearRow = document.createElement('button');
+  clearRow.className = 'clear-row';
+  clearRow.type = 'button';
+  clearRow.textContent = 'Clear';
+  clearRow.title = 'Clear semantics are deferred';
+  body.append(clearRow);
+
+  const newTab = document.createElement('button');
+  newTab.className = 'new-tab-row';
+  newTab.type = 'button';
+  newTab.append(evoIcon('plus', 17));
+  const newTabText = document.createElement('span');
+  newTabText.textContent = 'New Tab';
+  newTab.append(newTabText);
+  newTab.addEventListener('click', () => dispatch({type: 'newTab'}));
+  body.append(newTab);
+
+  for (const tab of snapshot.openTabs) {
+    body.append(tabItem(tab, callbacks));
+  }
+  shell.append(body);
+  shell.append(spaceSwitcher(
+      snapshot.spaces, snapshot.activeSpaceId,
+      spaceId => dispatch({type: 'selectSpace', spaceId})));
+  return shell;
+}
diff --git a/chrome/browser/resources/evo_shell/components/space_header.ts b/chrome/browser/resources/evo_shell/components/space_header.ts
