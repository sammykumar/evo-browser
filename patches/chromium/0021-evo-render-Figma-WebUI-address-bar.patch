@@ -0,0 +1,57 @@
+// Copyright 2026 SK Productions LLC
+
+import {evoIcon} from '../evo_icon.js';
+import {iconButton} from './icon_button.js';
+import type {EvoShellAction, EvoShellSnapshot} from '../types.js';
+
+export function toolbar(
+    snapshot: EvoShellSnapshot,
+    dispatch: (action: EvoShellAction) => void): HTMLElement {
+  const surface = document.createElement('div');
+  surface.className = 'evo-toolbar';
+  surface.dataset['surface'] = 'toolbar';
+  surface.classList.toggle('sidebar-collapsed', snapshot.sidebarCollapsed);
+
+  const navigation = document.createElement('div');
+  navigation.className = 'toolbar-navigation';
+  const back = iconButton('chevron-left', 'Back', () => {
+    dispatch({type: 'navigateBack'});
+  });
+  back.disabled = !snapshot.canGoBack;
+  const forward = iconButton('chevron-right', 'Forward', () => {
+    dispatch({type: 'navigateForward'});
+  });
+  forward.disabled = !snapshot.canGoForward;
+  const reload = iconButton('rotate-cw', 'Reload', () => {
+    dispatch({type: 'reload'});
+  });
+  reload.classList.toggle('is-loading', snapshot.isLoading);
+  navigation.append(back, forward, reload);
+
+  const urlForm = document.createElement('form');
+  urlForm.className = 'toolbar-url-form';
+  const searchIcon = evoIcon('search');
+  searchIcon.classList.add('toolbar-url-icon');
+  const input = document.createElement('input');
+  input.className = 'toolbar-url-input';
+  input.type = 'text';
+  input.value = snapshot.activeUrl;
+  input.placeholder = 'Search or enter URL';
+  input.title = snapshot.activeTitle || snapshot.activeUrl;
+  input.autocomplete = 'off';
+  input.spellcheck = false;
+  input.setAttribute('aria-label', 'Address and search');
+  urlForm.append(searchIcon, input);
+  urlForm.addEventListener('submit', event => {
+    event.preventDefault();
+    dispatch({type: 'navigate', url: input.value.trim()});
+  });
+
+  const railToggle = iconButton('panel-right', 'Toggle right rail', () => {
+    dispatch({type: 'toggleRightRail'});
+  });
+  railToggle.classList.toggle('is-active', snapshot.rightRailVisible);
+
+  surface.append(navigation, urlForm, railToggle);
+  return surface;
+}
