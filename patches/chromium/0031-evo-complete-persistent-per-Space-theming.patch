diff --git a/chrome/browser/ui/evo_shell/evo_space_theme.cc b/chrome/browser/ui/evo_shell/evo_space_theme.cc
new file mode 100644
index 0000000000000000000000000000000000000000..6f496add0275293353b253918d943ed1d93fbc0c
--- /dev/null
+++ b/chrome/browser/ui/evo_shell/evo_space_theme.cc
@@ -0,0 +1,135 @@
+// Copyright 2026 SK Productions LLC
+
+#include "chrome/browser/ui/evo_shell/evo_space_theme.h"
+
+#include <array>
+#include <cstdint>
+#include <optional>
+
+#include "base/hash/hash.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+#include "chrome/browser/ui/evo_shell/evo_shell_prefs.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace evo::shell {
+namespace {
+
+constexpr SkColor kWallpaperBase = SkColorSetRGB(0x0d, 0x0f, 0x13);
+
+struct Preset {
+  std::string_view mode;
+  std::string_view accent_1;
+  std::string_view accent_2;
+  std::string_view accent_core;
+  SkColor wallpaper_1;
+  SkColor wallpaper_2;
+};
+
+constexpr std::array<Preset, 5> kPresets = {{
+    {"agent", "#57dcd6", "#8f7bf3", "#bff4ff",
+     SkColorSetRGB(0x57, 0xdc, 0xd6), SkColorSetRGB(0x8f, 0x7b, 0xf3)},
+    {"personal", "#7c8cff", "#9b7bf3", "#cdd4ff",
+     SkColorSetRGB(0x7c, 0x8c, 0xff), SkColorSetRGB(0x9b, 0x7b, 0xf3)},
+    {"work", "#5fd3a3", "#4fb8d8", "#b8f5df",
+     SkColorSetRGB(0x5f, 0xd3, 0xa3), SkColorSetRGB(0x4f, 0xb8, 0xd8)},
+    {"media", "#f286a6", "#b06ff0", "#ffd0de",
+     SkColorSetRGB(0xf2, 0x86, 0xa6), SkColorSetRGB(0xb0, 0x6f, 0xf0)},
+    {"focus", "#6ea8f5", "#57dcd6", "#cfe6ff",
+     SkColorSetRGB(0x6e, 0xa8, 0xf5), SkColorSetRGB(0x57, 0xdc, 0xd6)},
+}};
+
+EvoSpaceTheme ThemeFromPreset(size_t index) {
+  const Preset& preset = kPresets[index];
+  return {.mode = std::string(preset.mode),
+          .accent_1 = std::string(preset.accent_1),
+          .accent_2 = std::string(preset.accent_2),
+          .accent_core = std::string(preset.accent_core),
+          .wallpaper_colors =
+              {preset.wallpaper_1, preset.wallpaper_2, kWallpaperBase}};
+}
+
+std::optional<SkColor> ParseCssSeed(std::string_view seed) {
+  if (seed.size() != 7 || seed.front() != '#') {
+    return std::nullopt;
+  }
+  uint32_t rgb = 0;
+  if (!base::HexStringToUInt(seed.substr(1), &rgb)) {
+    return std::nullopt;
+  }
+  return SkColorSetRGB((rgb >> 16) & 0xff, (rgb >> 8) & 0xff, rgb & 0xff);
+}
+
+std::string CssColor(SkColor color) {
+  return base::StringPrintf("#%02x%02x%02x", SkColorGetR(color),
+                            SkColorGetG(color), SkColorGetB(color));
+}
+
+uint8_t MixChannel(uint8_t from, uint8_t to, int to_percent) {
+  return static_cast<uint8_t>(
+      (from * (100 - to_percent) + to * to_percent + 50) / 100);
+}
+
+SkColor MixColor(SkColor from, SkColor to, int to_percent) {
+  return SkColorSetRGB(
+      MixChannel(SkColorGetR(from), SkColorGetR(to), to_percent),
+      MixChannel(SkColorGetG(from), SkColorGetG(to), to_percent),
+      MixChannel(SkColorGetB(from), SkColorGetB(to), to_percent));
+}
+
+EvoSpaceTheme ThemeFromSeed(SkColor seed) {
+  // Keep the selected seed as the core identity. The two gradient endpoints
+  // are deterministic 15% mixes toward white and black respectively.
+  const SkColor accent_1 = MixColor(seed, SK_ColorWHITE, 15);
+  const SkColor accent_2 = MixColor(seed, SK_ColorBLACK, 15);
+  return {.mode = "custom",
+          .accent_1 = CssColor(accent_1),
+          .accent_2 = CssColor(accent_2),
+          .accent_core = CssColor(seed),
+          .wallpaper_colors = {accent_1, accent_2, kWallpaperBase}};
+}
+
+std::optional<size_t> NamedPreset(std::string_view name) {
+  for (size_t index = 0; index < kPresets.size(); ++index) {
+    if (base::EqualsCaseInsensitiveASCII(name, kPresets[index].mode)) {
+      return index;
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace
+
+EvoSpaceTheme ResolveSpaceTheme(const PrefService& prefs,
+                                std::string_view space_id,
+                                std::string_view space_name) {
+  if (const std::string* custom_seed =
+          prefs.GetDict(prefs::kSpaceThemes).FindString(space_id)) {
+    if (const std::optional<SkColor> color = ParseCssSeed(*custom_seed)) {
+      return ThemeFromSeed(*color);
+    }
+  }
+  if (space_id == "default") {
+    return ThemeFromPreset(0);
+  }
+  if (const std::optional<size_t> named = NamedPreset(space_name)) {
+    return ThemeFromPreset(*named);
+  }
+  return ThemeFromPreset(base::PersistentHash(space_id) % kPresets.size());
+}
+
+bool SetSpaceSeed(PrefService& prefs,
+                  std::string_view space_id,
+                  std::string_view css_seed) {
+  const std::optional<SkColor> color = ParseCssSeed(css_seed);
+  if (space_id.empty() || !color) {
+    return false;
+  }
+  ScopedDictPrefUpdate update(&prefs, prefs::kSpaceThemes);
+  update->Set(space_id, CssColor(*color));
+  return true;
+}
+
+}  // namespace evo::shell
