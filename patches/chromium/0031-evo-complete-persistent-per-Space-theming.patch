+namespace evo::shell {
+namespace {
+
+class EvoSpaceThemeTest : public testing::Test {
+ protected:
+  EvoSpaceThemeTest() {
+    prefs_.registry()->RegisterDictionaryPref(prefs::kSpaceThemes);
+  }
+
+  TestingPrefServiceSimple prefs_;
+};
+
+TEST_F(EvoSpaceThemeTest, ResolvesExactNamedPresets) {
+  struct TestCase {
+    std::string_view name;
+    std::string_view mode;
+    std::string_view accent_1;
+    std::string_view accent_2;
+    std::string_view accent_core;
+  };
+  constexpr std::array<TestCase, 5> kCases = {{
+      {"Agent", "agent", "#57dcd6", "#8f7bf3", "#bff4ff"},
+      {"Personal", "personal", "#7c8cff", "#9b7bf3", "#cdd4ff"},
+      {"Work", "work", "#5fd3a3", "#4fb8d8", "#b8f5df"},
+      {"Media", "media", "#f286a6", "#b06ff0", "#ffd0de"},
+      {"Focus", "focus", "#6ea8f5", "#57dcd6", "#cfe6ff"},
+  }};
+
+  for (const auto& test_case : kCases) {
+    const EvoSpaceTheme theme =
+        ResolveSpaceTheme(prefs_, std::string(test_case.name), test_case.name);
+    EXPECT_EQ(test_case.mode, theme.mode);
+    EXPECT_EQ(test_case.accent_1, theme.accent_1);
+    EXPECT_EQ(test_case.accent_2, theme.accent_2);
+    EXPECT_EQ(test_case.accent_core, theme.accent_core);
+  }
+}
+
+TEST_F(EvoSpaceThemeTest, DefaultSpaceAlwaysUsesAgentPreset) {
+  EXPECT_EQ("agent", ResolveSpaceTheme(prefs_, "default", "Work").mode);
+}
+
+TEST_F(EvoSpaceThemeTest, UnnamedSpacesResolveStablyById) {
+  const EvoSpaceTheme first = ResolveSpaceTheme(prefs_, "stable-id", "Space 1");
+  ResolveSpaceTheme(prefs_, "another-id", "Space 2");
+  EXPECT_EQ(first, ResolveSpaceTheme(prefs_, "stable-id", "Space 99"));
+}
+
+TEST_F(EvoSpaceThemeTest, PersistsNormalizedCustomSeedAndDerivesEndpoints) {
+  ASSERT_TRUE(SetSpaceSeed(prefs_, "custom", "#336699"));
+  EXPECT_EQ("#336699",
+            *prefs_.GetDict(prefs::kSpaceThemes).FindString("custom"));
+
+  const EvoSpaceTheme theme = ResolveSpaceTheme(prefs_, "custom", "Anything");
+  EXPECT_EQ("custom", theme.mode);
+  EXPECT_EQ("#527da8", theme.accent_1);
+  EXPECT_EQ("#2b5782", theme.accent_2);
+  EXPECT_EQ("#336699", theme.accent_core);
+
+  ASSERT_TRUE(SetSpaceSeed(prefs_, "uppercase", "#A0B1C2"));
+  EXPECT_EQ("#a0b1c2",
+            *prefs_.GetDict(prefs::kSpaceThemes).FindString("uppercase"));
+}
+
+TEST_F(EvoSpaceThemeTest, RejectsMalformedSeedsWithoutMutatingPrefs) {
+  for (std::string_view seed : {"336699", "#369", "#gg6699", "#33669900"}) {
+    EXPECT_FALSE(SetSpaceSeed(prefs_, "custom", seed));
+  }
+  EXPECT_FALSE(SetSpaceSeed(prefs_, "", "#336699"));
+  EXPECT_TRUE(prefs_.GetDict(prefs::kSpaceThemes).empty());
+}
+
+}  // namespace
+}  // namespace evo::shell
