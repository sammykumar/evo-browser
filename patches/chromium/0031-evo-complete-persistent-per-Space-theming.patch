+  auto* coordinator = browser_view->evo_shell_coordinator();
+  ASSERT_TRUE(host);
+  ASSERT_TRUE(coordinator);
+  base::DictValue snapshot = coordinator->BuildSnapshot();
+  const std::string expected = *snapshot.FindString("accent1");
+  content::WebContents* sidebar =
+      host->sidebar_web_view_for_testing()->GetWebContents();
+  ASSERT_TRUE(sidebar);
+  ASSERT_TRUE(content::WaitForLoadStop(sidebar));
+  EXPECT_EQ(expected, content::EvalJs(sidebar, R"(
+    new Promise(resolve => {
+      const readAccent = () => {
+        const value = document.documentElement.style
+            .getPropertyValue('--accent-1');
+        if (value) {
+          resolve(value);
+        } else {
+          setTimeout(readAccent, 10);
+        }
+      };
+      readAccent();
+    })
+  )"));
